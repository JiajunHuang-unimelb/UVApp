<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not upload cached coordinates or UV rows to cloud backup. -->
        <exclude
            domain="database"
            path="." />
        <!-- Saved indoor places hold precise home/work coordinates; first-run offers should reappear on a new install. -->
        <exclude
            domain="file"
            path="datastore/indoor_locations.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="first_run.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The cache is recreated for the new device and location. -->
        <exclude
            domain="database"
            path="." />
        <!-- Saved indoor places hold precise home/work coordinates; first-run offers should reappear on a new install. -->
        <exclude
            domain="file"
            path="datastore/indoor_locations.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="first_run.xml" />
    </device-transfer>
</data-extraction-rules>
